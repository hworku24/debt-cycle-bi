POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=debt_cycle
POSTGRES_USER=bi_user
POSTGRES_PASSWORD=change_me

# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_key_here

# Optional, for the monthly executive brief (Claude on Amazon Bedrock).
# Standard AWS credentials (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY) or an
# AWS profile must also be available; the brief skips cleanly without them.
AWS_REGION=us-east-1
BRIEF_MODEL=anthropic.claude-opus-5
